{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on",
        "useSortedEnumMembers": "on",
        "useSortedAttributes": "on",
        "useSortedTypeFields": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on",
        "useSortedSelectionSet": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended",
      "tailwind": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 4,
      "jsxQuoteStyle": "double",
      "attributePosition": "auto"
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "double",
      "delimiterSpacing": true,
      "indentStyle": "space",
      "indentWidth": 4,
      "trailingNewline": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "delimiterSpacing": true,
      "indentStyle": "space",
      "indentWidth": 4,
      "trailingNewline": true,
      "trailingCommas": "all"
    }
  }
}
